  <diagram id="cgs-wiki-full-stack-delivery" name="Full Wiki delivery and consumers">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1595" pageHeight="768" arrows="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="CGS Wiki delivery across the stack" style="text;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="25" width="1498" height="44" /></mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" value="Planned W1–W5 contracts. Each path uses shared world identities and an authorized view." style="text;align=left;verticalAlign=middle;fontSize=16;fontStyle=0;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="70" width="1498" height="31" /></mxCell>
        <mxCell id="lane1" parent="1" vertex="1" value="React browser" style="text;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="113" width="320" height="33" /></mxCell>
        <mxCell id="lane2" parent="1" vertex="1" value="Django and API" style="text;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#172D43;"><mxGeometry as="geometry" x="421" y="113" width="323" height="33" /></mxCell>
        <mxCell id="lane3" parent="1" vertex="1" value="PostgreSQL and persistent assets" style="text;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#172D43;"><mxGeometry as="geometry" x="802" y="113" width="354" height="33" /></mxCell>
        <mxCell id="lane4" parent="1" vertex="1" value="Authorized consumers" style="text;align=left;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#172D43;"><mxGeometry as="geometry" x="1214" y="113" width="332" height="33" /></mxCell>
        <mxCell id="r1c1" parent="1" vertex="1" value="Worlds dashboard and Wiki&#10;Curated world home, article catalogs, Read and Build" style="rounded=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontSize=15;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="156" width="320" height="91" /></mxCell>
        <mxCell id="r1c2" parent="1" vertex="1" value="Scoped Wiki reads and writes&#10;Bounded home read and validated edits with receipts" style="rounded=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontSize=15;fillColor=#FFF4DD;strokeColor=#CFAD65;fontColor=#172D43;"><mxGeometry as="geometry" x="421" y="156" width="323" height="91" /></mxCell>
        <mxCell id="r1c3" parent="1" vertex="1" value="WikiWorld and WikiEntry&#10;Introduction, cover and featured IDs. Stable articles and dated facts." style="rounded=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontSize=15;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;"><mxGeometry as="geometry" x="802" y="156" width="354" height="91" /></mxCell>
        <mxCell id="r1c4" parent="1" vertex="1" value="Encyclopedia and worldbuilding&#10;A saved article or link opens the same authorized entity in each tool" style="rounded=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontSize=15;fillColor=#EBF7EF;strokeColor=#91BA9F;fontColor=#172D43;"><mxGeometry as="geometry" x="1214" y="156" width="332" height="91" /></mxCell>
        <mxCell id="r2c1" parent="1" vertex="1" value="Maps, timeline and article history&#10;Image canvas and pin list, explicit write dates, historical links" style="rounded=1;arcSize=12;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=12;fontSize=15;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="270" width="320" height="91" /></mxCell>
