        <mxCell id="writer" parent="1" vertex="1" value="Shared Wiki write boundary&#10;Check real account access and prior receipt. Validate the full candidate and save its records in one transaction." style="rounded=1;arcSize=10;whiteSpace=wrap;spacing=10;fontSize=16;fillColor=#FFF4DD;strokeColor=#CFAD65;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="246" width="1198" height="79" /></mxCell>
        <mxCell id="facts" parent="1" vertex="1" value="Identities and dated facts&#10;Class and species defaults, measured values with recorded units" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="378" width="274" height="104" /></mxCell>
        <mxCell id="links" parent="1" vertex="1" value="Typed links and spatial data&#10;Assignments and ordered goals, measured plans and map pins" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;"><mxGeometry as="geometry" x="354" y="378" width="274" height="104" /></mxCell>
        <mxCell id="evidence" parent="1" vertex="1" value="Sources and knowledge&#10;Uncertain and corrected claims, observation snapshots and beliefs" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;"><mxGeometry as="geometry" x="662" y="378" width="274" height="104" /></mxCell>
        <mxCell id="events" parent="1" vertex="1" value="Event tree and dated leaves&#10;Exact, approximate or unknown dates. Explicit targets and effects." style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;"><mxGeometry as="geometry" x="970" y="378" width="274" height="104" /></mxCell>
        <mxCell id="reader" parent="1" vertex="1" value="Scoped Wiki read boundary&#10;Authorize the caller, resolve the selected time and viewpoint, then return permitted facts, evidence and related records." style="rounded=1;arcSize=10;whiteSpace=wrap;spacing=10;fontSize=16;fillColor=#FFF4DD;strokeColor=#CFAD65;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="534" width="1198" height="79" /></mxCell>
        <mxCell id="articles" parent="1" vertex="1" value="Author articles and timeline&#10;Family links, dated facts, shared event outline and chronology" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="668" width="362" height="94" /></mxCell>
        <mxCell id="viewpoint" parent="1" vertex="1" value="Character preview&#10;At the selected date, show known identities, beliefs and evidence" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;"><mxGeometry as="geometry" x="470" y="668" width="352" height="94" /></mxCell>
        <mxCell id="consumers" parent="1" vertex="1" value="Later CGS consumers&#10;Simulation owns live runs. Media owns selection and reveal order." style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=8;fontSize=15;fillColor=#F4F5F7;strokeColor=#A5B0BC;fontColor=#172D43;"><mxGeometry as="geometry" x="884" y="668" width="360" height="94" /></mxCell>
