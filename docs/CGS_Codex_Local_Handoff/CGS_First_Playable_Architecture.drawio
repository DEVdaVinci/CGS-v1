        <mxCell id="author" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Author view&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Resolve the world state at the requested date.&lt;br&gt;Inspect sources and conflicting values.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="147" width="332" height="106" /></mxCell>
        <mxCell id="viewer" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Actor or audience view&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Resolve permitted evidence and disclose&lt;br&gt;information only in its allowed context.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="333" width="332" height="115" /></mxCell>
        <mxCell id="review" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Issue review&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Show authorized findings and pending checks.&lt;br&gt;Link to the affected records and rules.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="577" width="332" height="114" /></mxCell>
        <mxCell id="note" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Corrections and fictional changes&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;A correction changes what canon says for an interval. A fictional event adds a dated change. An independent claim retains what its source said.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F4F6F8;strokeColor=#ADB8C5;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="736" width="1358" height="70" /></mxCell>
      </root>
