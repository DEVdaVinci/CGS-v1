        <mxCell id="subtitle" parent="1" vertex="1" value="Character, place, and timeline authoring through the shared Wiki writer and reader." style="text;align=left;verticalAlign=middle;fontSize=15;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="70" width="1198" height="27" /></mxCell>
        <mxCell id="character" parent="1" vertex="1" value="Characters and Library&#10;Identity, biography, family, profiles and reusable definitions" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=10;fontSize=15;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;"><mxGeometry as="geometry" x="46" y="122" width="362" height="76" /></mxCell>
        <mxCell id="place" parent="1" vertex="1" value="Places, Layout and Maps&#10;Spatial records, measured plans and image pins linked to places" style="rounded=1;arcSize=12;whiteSpace=wrap;spacing=10;fontSize=15;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;"><mxGeometry as="geometry" x="470" y="122" width="352" height="76" /></mxCell>
