              "maxItems": 30,
              "minItems": 1,
              "uniqueItems": true
            },
            "policy": {
              "$ref": "#/$defs/ActorPolicy"
            }
          },
          "required": [
            "kind",
            "id",
            "name",
            "visibility",
            "archetype",
            "role_id",
            "action_rule_ids",
            "policy"
