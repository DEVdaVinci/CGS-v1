        <mxCell id="author" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Browser authoring&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Create and link records.&lt;br&gt;Correct values or record dated changes.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="145" width="252" height="106" /></mxCell>
        <mxCell id="proposal" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Reviewed proposal&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Stage an import or AI-assisted draft.&lt;br&gt;Review changes and their sources.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="285" width="252" height="112" /></mxCell>
        <mxCell id="query" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Read request&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;World, fictional time, authorized&lt;br&gt;viewpoint, and purpose.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="484" width="252" height="108" /></mxCell>
        <mxCell id="write" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Django authoring API&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Check current access and change intent.&lt;br&gt;Stage one candidate change group.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="177" width="278" height="121" /></mxCell>
        <mxCell id="check" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Consistency checks&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Check references, time, rules, and&lt;br&gt;exceptions. Apply the save policy.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#FFF3DD;strokeColor=#CAA46D;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="704" y="177" width="299" height="121" /></mxCell>
        <mxCell id="store" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;PostgreSQL world records&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Stable entities, dated facts and links,&lt;br&gt;events, evidence, findings, and jobs.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="704" y="348" width="299" height="119" /></mxCell>
        <mxCell id="read" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Scoped query service&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Resolve current permission and&lt;br&gt;the requested time and viewpoint.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="484" width="278" height="108" /></mxCell>
        <mxCell id="view" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Authorized projection&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Return the allowed facts or observations&lt;br&gt;with sources and check status.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="704" y="520" width="299" height="116" /></mxCell>
        <mxCell id="feedback" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Save and review&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Accepted, checking, or blocked.&lt;br&gt;Show authorized findings and repair links.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="149" width="332" height="116" /></mxCell>
        <mxCell id="wiki" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Browser Wiki&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Articles, sources, timelines, maps,&lt;br&gt;search, and audience previews.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="463" width="332" height="103" /></mxCell>
        <mxCell id="game" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Event engine and games&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Phase 2 resolves events. Tabletop, 2D,&lt;br&gt;and 3D use scoped state and geometry.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="592" width="332" height="112" /></mxCell>
        <mxCell id="media" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Story and media&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Event, entity, layout, and asset references.&lt;br&gt;Audiences can learn in a different order.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1071" y="732" width="332" height="112" /></mxCell>
        <mxCell id="note" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;First implementation increment&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Author and read Cedar Gate through React, the API, and PostgreSQL.&lt;br&gt;The next pages show the shared records and how a check affects a save.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F4F6F8;strokeColor=#ADB8C5;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="698" width="599" height="106" /></mxCell>
