        <mxCell id="policy" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Access and author policy&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;World access and permitted viewpoints.&lt;br&gt;Author guardrails and conflict policy.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="577" width="252" height="114" /></mxCell>
