        <mxCell id="candidate" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Candidate change&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Exact edit group and expected&lt;br&gt;current state. Check all affected inputs.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="577" width="278" height="114" /></mxCell>
        <mxCell id="canon" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Canonical assertions&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Typed values, effective intervals,&lt;br&gt;visibility, and source references.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="704" y="147" width="299" height="106" /></mxCell>
