        <mxCell id="flow-5" parent="1" edge="1" source="event" target="links" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.45;strokeColor=#48647D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="flow-6" parent="1" edge="1" source="links" target="timeline" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;endFill=1;strokeWidth=1.45;strokeColor=#48647D;exitX=1;exitY=0.5;entryX=0;entryY=0.5;"><mxGeometry as="geometry" relative="1" /></mxCell>
        <mxCell id="title" parent="1" vertex="1" value="Core Wiki authoring and timeline" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=28;fontStyle=1;"><mxGeometry as="geometry" x="48" y="22" width="1120" height="40" /></mxCell>
        <mxCell id="subtitle" parent="1" vertex="1" value="Author-view connections for the Phase 1 world model." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=15;fontStyle=0;"><mxGeometry as="geometry" x="48" y="63" width="1120" height="24" /></mxCell>
        <mxCell id="inputs" parent="1" vertex="1" value="Authoring" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=16;fontStyle=1;"><mxGeometry as="geometry" x="48" y="98" width="294" height="24" /></mxCell>
        <mxCell id="records" parent="1" vertex="1" value="World records" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=16;fontStyle=1;"><mxGeometry as="geometry" x="411" y="98" width="356" height="24" /></mxCell>
        <mxCell id="views" parent="1" vertex="1" value="Browser views" style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=16;fontStyle=1;"><mxGeometry as="geometry" x="839" y="98" width="355" height="24" /></mxCell>
        <mxCell id="create" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Create an article&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Characters, places, and library types.&lt;br&gt;Pick linked records for initial facts.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="48" y="141" width="294" height="112" /></mxCell>
        <mxCell id="learn" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Record a learned ability&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Choose the character, ability, and time.&lt;br&gt;Attach an optional source.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="48" y="321" width="294" height="112" /></mxCell>
        <mxCell id="event" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Author an event&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Choose the time, participants, places, and items.&lt;br&gt;Record a use or a group of state changes.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="48" y="501" width="294" height="112" /></mxCell>
        <mxCell id="canon" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Stable identity and typed facts&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;One identity per authored object.&lt;br&gt;Type fields and locations resolve at world time.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="411" y="141" width="356" height="112" /></mxCell>
        <mxCell id="grant" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Dated learning record&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Connect a character to a reusable ability.&lt;br&gt;Keep the definition and learning record separate.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="411" y="321" width="356" height="112" /></mxCell>
        <mxCell id="links" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Event, links, and dated changes&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Persist one event with its own identity.&lt;br&gt;Commit intended state changes together.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="411" y="501" width="356" height="112" /></mxCell>
        <mxCell id="articles" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Read and browse articles&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Follow a class, place, or child room.&lt;br&gt;See facts at the chosen world time.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="839" y="141" width="355" height="112" /></mxCell>
        <mxCell id="cap" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Learned abilities on the character&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Show what was learned by the selected time.&lt;br&gt;Open the ability definition by identity.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="839" y="321" width="355" height="112" /></mxCell>
        <mxCell id="timeline" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;World timeline&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Group independent events at the same time.&lt;br&gt;Follow participants and effects to dated articles.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;"><mxGeometry as="geometry" x="839" y="501" width="355" height="112" /></mxCell>
        <mxCell id="scope" parent="1" vertex="1" value="Canonical changes affect the dated facts. A character preview reads its recorded knowledge. Rule evaluation and simulated action resolution have separate contracts." style="text;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#172D43;fontSize=15;fontStyle=0;"><mxGeometry as="geometry" x="48" y="644" width="1146" height="58" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="cgs-wiki-w1-implementation" name="W1 Core worldbuilding design">
    <mxGraphModel grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1292" pageHeight="855" arrows="1">
