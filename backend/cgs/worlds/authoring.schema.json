{
  "$defs": {
    "Id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "Revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "Digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "Audience": {
      "type": "string",
      "pattern": "^(party|actor:[0-9a-f-]{36})$"
    },
    "AudienceGrants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Audience"
      },
      "maxItems": 30,
      "minItems": 1,
      "uniqueItems": true
    },
    "IdArray": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Id"
      },
      "maxItems": 500,
      "minItems": 0,
      "uniqueItems": true
    },
    "PointCm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        },
        "y_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        }
      },
      "required": [
        "x_cm",
        "y_cm"
      ]
    },
    "BoundsCm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "x_min_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        },
        "y_min_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        },
        "x_max_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        },
        "y_max_cm": {
          "type": "integer",
          "minimum": -100000000,
          "maximum": 100000000
        }
      },
      "required": [
        "x_min_cm",
        "y_min_cm",
        "x_max_cm",
        "y_max_cm"
      ]
    },
    "LayoutPoint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "place_id": {
          "$ref": "#/$defs/Id"
        },
        "at": {
          "$ref": "#/$defs/PointCm"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "public",
            "observed",
            "author"
          ]
        }
      },
      "required": [
        "id",
        "label",
        "place_id",
        "at",
        "visibility"
      ]
    },
    "LayoutEdge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/Id"
        },
        "from_point_id": {
          "$ref": "#/$defs/Id"
        },
        "to_point_id": {
          "$ref": "#/$defs/Id"
        },
        "traversable": {
          "type": "boolean"
        },
        "required_fact_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/Id"
            }
          ]
        }
      },
      "required": [
        "id",
        "from_point_id",
        "to_point_id",
        "traversable",
        "required_fact_id"
      ]
    },
    "Layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frame_id": {
          "$ref": "#/$defs/Id"
        },
        "unit": {
          "const": "cm"
        },
        "origin": {
          "$ref": "#/$defs/PointCm"
        },
        "grid_cm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "points": {
          "type": "object",
          "patternProperties": {
            "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$": {
              "$ref": "#/$defs/LayoutPoint"
            }
          },
          "additionalProperties": false,
          "maxProperties": 100
        },
        "edges": {
          "type": "object",
          "patternProperties": {
            "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$": {
              "$ref": "#/$defs/LayoutEdge"
            }
          },
          "additionalProperties": false,
          "maxProperties": 300
        }
      },
      "required": [
        "frame_id",
        "unit",
        "origin",
        "grid_cm",
        "points",
        "edges"
      ]
    },
    "ActorPolicy": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "hold"
            }
          },
          "required": [
            "mode"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "const": "alarm_move"
            },
            "stimulus_fact_id": {
              "$ref": "#/$defs/Id"
            },
            "destination_point_id": {
              "$ref": "#/$defs/Id"
            },
            "move_rule_id": {
              "$ref": "#/$defs/Id"
            }
          },
          "required": [
            "mode",
            "stimulus_fact_id",
            "destination_point_id",
            "move_rule_id"
          ]
        }
      ]
    },
    "Entity": {
      "oneOf": [
