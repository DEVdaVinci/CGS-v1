        <mxCell id="change" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Candidate edit group&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Manual, imported, or reviewed AI edits.&lt;br&gt;Expected current edit state.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="151" width="255" height="111" /></mxCell>
        <mxCell id="structure" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Check access and structure&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Validate permissions, types, identities,&lt;br&gt;references, and the order of interval bounds.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="151" width="290" height="111" /></mxCell>
        <mxCell id="impact" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Find affected records&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Follow fields, queries, rules, and time ranges.&lt;br&gt;Widen the check where impact is uncertain.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="718" y="151" width="304" height="111" /></mxCell>
        <mxCell id="reject" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Structural or access error&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Reject the canonical write.&lt;br&gt;Explain permitted details of the failure.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#FCEFEA;strokeColor=#C58875;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1082" y="151" width="344" height="111" /></mxCell>
        <mxCell id="inputs" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Rule and evidence&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Effective time and purpose of the rule.&lt;br&gt;Values at that time and approved alternatives.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EDF5FE;strokeColor=#8EB4DC;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="377" width="255" height="123" /></mxCell>
        <mxCell id="evaluate" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Evaluate at the relevant time&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Check the operation and applicable rule.&lt;br&gt;Report a conflict or missing evidence.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="377" width="290" height="123" /></mxCell>
        <mxCell id="decision" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Apply the world save policy&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Choose save and flag or block confirmed&lt;br&gt;contradictions. Record work with save or hold.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#FFF3DD;strokeColor=#CAA46D;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="718" y="377" width="304" height="123" /></mxCell>
        <mxCell id="outcome" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Save result and status&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Accept, accept with a finding or pending check,&lt;br&gt;hold, or block with an explanation.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#EAF5EF;strokeColor=#88B19C;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1082" y="377" width="344" height="123" /></mxCell>
        <mxCell id="pending" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Pending check&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Store exact inputs and current edit state.&lt;br&gt;Keep the checking status visible.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F3EDFB;strokeColor=#AE96C9;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="635" width="255" height="126" /></mxCell>
        <mxCell id="worker" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Run the remaining checks&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Process durable work and handle retries.&lt;br&gt;Treat failures as unfinished checks.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#E9F3FF;strokeColor=#7CA5D0;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="366" y="635" width="290" height="126" /></mxCell>
        <mxCell id="fresh" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Verify the result is current&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Recheck inputs, policy, and write access.&lt;br&gt;Supersede stale work and recheck.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#FFF3DD;strokeColor=#CAA46D;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="718" y="635" width="304" height="126" /></mxCell>
        <mxCell id="issues" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Current findings&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;Record current-canon findings and status.&lt;br&gt;Keep blocked attempts with their candidates.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#FCEFEA;strokeColor=#C58875;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="1082" y="635" width="344" height="126" /></mxCell>
        <mxCell id="note" parent="1" vertex="1" value="&lt;div style=&quot;font-size:17px;font-weight:bold;margin-bottom:7px&quot;&gt;Rule change example&lt;/div&gt;&lt;div style=&quot;font-size:14px;line-height:1.28&quot;&gt;A later acquisition rule uses its own effective date. A correction to the rule at an earlier grant can make that grant inconsistent.&lt;br&gt;A separate retention rule can affect existing holders. A permitted alternative grant can satisfy an otherwise unmet requirement.&lt;/div&gt;" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=13;spacingRight=11;strokeWidth=1.25;fillColor=#F4F6F8;strokeColor=#ADB8C5;fontColor=#172D43;fontFamily=Helvetica;fontSize=14;"><mxGeometry as="geometry" x="45" y="824" width="1381" height="94" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
